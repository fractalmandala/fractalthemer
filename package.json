{
  "name": "fractalthemer",
  "version": "0.7.0",
  "description": "A class-based styling system: layered indented SASS with a generated class registry, semantic tokens, themes and auras, a Svelte 5 mode store with animated view transitions, and a shipped contract linter",
  "license": "MIT",
  "author": "Amritanshu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fractalmandala/fractalthemer.git"
  },
  "bugs": "https://github.com/fractalmandala/fractalthemer/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./styles": "./dist/styles/index.sass",
    "./styles/tokens": "./dist/styles/_tokens.sass",
    "./styles/themes": "./dist/styles/_themes.sass",
    "./styles/auras": "./dist/styles/_auras.sass",
    "./styles/glass": "./dist/styles/_glass.sass",
    "./styles/picker": "./dist/styles/_theme-picker.sass",
    "./styles/*": "./dist/styles/*",
    "./tokens": "./dist/styles/_tokens.sass",
    "./themes": "./dist/styles/_themes.sass",
    "./auras": "./dist/styles/_auras.sass",
    "./glass": "./dist/styles/_glass.sass",
    "./picker": "./dist/styles/_theme-picker.sass",
    "./script": {
      "types": "./dist/utils/anti-flicker.d.ts",
      "default": "./dist/utils/anti-flicker.js"
    },
    "./mode": {
      "types": "./dist/state/mode.svelte.d.ts",
      "svelte": "./dist/state/mode.svelte.js",
      "default": "./dist/state/mode.svelte.js"
    },
    "./motion": {
      "types": "./dist/motion/transitions.d.ts",
      "default": "./dist/motion/transitions.js"
    },
    "./motion/easing": {
      "types": "./dist/motion/easing.d.ts",
      "default": "./dist/motion/easing.js"
    },
    "./transition.css": "./dist/motion/transition.css"
  },
  "bin": {
    "fractalthemer": "./bin/lint.mjs"
  },
  "files": [
    "dist",
    "bin",
    "lint",
    "scripts/build-registry.mjs",
    "src/lib/data/registry.json",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "src/lib/motion",
    "src/lib/state",
    "src/lib/mode",
    "src/lib/icons/Sun.svelte",
    "src/lib/icons/Moon.svelte",
    "scripts/class-vocab.mjs",
    "src/lib/data/registry.api.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.sass"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "registry": "node scripts/build-registry.mjs",
    "lint": "node bin/lint.mjs",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "node scripts/build-registry.mjs && svelte-kit sync && svelte-package && sass src/lib/styles/index.sass dist/styles/index.css --no-source-map",
    "package": "node scripts/build-registry.mjs && svelte-kit sync && svelte-package && sass src/lib/styles/index.sass dist/styles/index.css --no-source-map",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24.0.0",
    "sass": "^1.102.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "design-system",
    "css",
    "sass",
    "tokens",
    "dark-mode",
    "themes",
    "linter"
  ]
}
